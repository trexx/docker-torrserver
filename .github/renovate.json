{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>trexx/actions",
    "github>trexx/actions:docker"
  ],
  "packageRules": [
    {
      "description": "The web UI builds with react-scripts 4, which needs Node 16 (as upstream's Dockerfile)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<17"
    },
    {
      "enabled": false,
      "matchDepTypes":[
        "stage"
      ]
    }
  ],
  "enabledManagers": [
    "dockerfile"
  ]
}
